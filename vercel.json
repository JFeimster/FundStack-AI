{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "*": false
    }
  },
  "redirects": [
    { "source": "/products.html", "destination": "/funding/products.html", "permanent": true },
    { "source": "/guide.html", "destination": "/partners/guide.html", "permanent": true },
    { "source": "/link-in-bio.html", "destination": "/partners/link-in-bio.html", "permanent": true },
    { "source": "/fund-match-quiz.html", "destination": "/tools/fund-match-quiz.html", "permanent": true },
    { "source": "/startup-planner.html", "destination": "/tools/startup-planner.html", "permanent": true },
    { "source": "/cost-of-capital.html", "destination": "/tools/cost-of-capital.html", "permanent": true },
    { "source": "/tools/dscr-precheck.html", "destination": "/dscr-precheck.html", "permanent": true },
    { "source": "/tools/ecom-cashflow-tool.html", "destination": "/tools/amazon-cashflow.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    { "source": "/", "headers": [{ "key": "Link", "value": "<https://fundstack.distilledfunding.com/>; rel=\"canonical\"" }] },
